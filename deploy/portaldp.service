[Unit]
Description=Portal DP Web App
After=network.target

[Service]
Type=simple
User=portaldp
Group=portaldp
WorkingDirectory=/opt/portaldp
EnvironmentFile=-/etc/portaldp/portaldp.secrets.env
EnvironmentFile=/opt/portaldp/.env
ExecStart=/usr/bin/python3 /opt/portaldp/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
